          },
          {
            "macro": "{$ELTEX.PS.RED.OID}",
            "value": "1.3.6.1.4.1.89.53.15.1.3.1",
            "description": "rlPhdUnitEnvParamRedundantPSStatus"
          },
          {
            "macro": "{$ELTEX.TEMP.OID}",
            "value": "1.3.6.1.4.1.89.53.15.1.10.1",
            "description": "rlPhdUnitEnvParamTempSensorValue"
          },
          {
            "macro": "{$ELTEX.SFP.VENDOR.OID}",
            "value": "1.3.6.1.4.1.35265.1.23.53.1.1.1.5",
            "description": "eltPhdTransceiverInfoVendorName - ПРОВЕРИТЬ snmpwalk-ом"
          },
          {
            "macro": "{$ELTEX.SFP.PART.OID}",
            "value": "1.3.6.1.4.1.35265.1.23.53.1.1.1.6",
            "description": "eltPhdTransceiverInfoPartNumber - ПРОВЕРИТЬ"
          },
          {
            "macro": "{$ELTEX.SFP.SERIAL.OID}",
            "value": "1.3.6.1.4.1.35265.1.23.53.1.1.1.7",
            "description": "eltPhdTransceiverInfoSerialNumber - ПРОВЕРИТЬ"
          }
        ],
